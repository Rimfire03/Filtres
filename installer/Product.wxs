<?xml version="1.0" encoding="utf-8"?>
<!-- Paquet MSI de Filtres (WiX 4, par machine, 64 bits). Construit par tools\Release.ps1 :
     wix build installer\Product.wxs -d Version=x.y.z -d PublishDir=<dossier publish> -d IconPath=<app.ico> -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Filtres" Manufacturer="TomLine prod&amp;co" Version="$(Version)"
           UpgradeCode="2C18CFB5-6EE1-43E5-A889-ACE458362778" Scope="perMachine" Language="1036" Codepage="1252">

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Filtres est déjà installée." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="app.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FiltresApp">

        <Component Id="MainExe" Guid="*">
          <File Id="FiltresAppExe" Source="$(PublishDir)\FiltresApp.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Filtres"
                      WorkingDirectory="INSTALLFOLDER" Advertise="no" />
          </File>
        </Component>

        <!-- Les données (base, réglages, exports) vivent dans FiltreData, à côté de l'exécutable : le dossier
             doit rester inscriptible pour les utilisateurs standard. -->
        <Directory Id="DATADIR" Name="FiltreData">
          <Component Id="DataFolder" Guid="7D3B1E52-4C0A-4B8E-9F6A-3A5E8C21D047">
            <CreateFolder>
              <util:PermissionEx User="Users" GenericAll="yes" />
            </CreateFolder>
          </Component>
          <Directory Id="LATODIR" Name="LatoFont" />
        </Directory>

        <!-- Clé de registre propre à l'application : InstallDir signale la version installée ; l'application y
             écrit sa valeur de licence, d'où l'accès en écriture pour les utilisateurs standard. -->
        <Component Id="AppRegistry" Guid="*" Bitness="always64">
          <RegistryKey Root="HKLM" Key="SOFTWARE\TomLine\FiltresApp" ForceCreateOnInstall="yes">
            <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            <util:PermissionEx User="Users" GenericAll="yes" />
          </RegistryKey>
        </Component>

      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Filtres" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="AppRegistry" />
      <ComponentGroupRef Id="DataFiles" />
    </Feature>

  </Package>

</Wix>
