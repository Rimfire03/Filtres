<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:FiltresApp">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Background" Value="{StaticResource BrushBackground}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    </Style>

    <!-- En-tête de colonne DataGrid qui passe à la ligne au lieu d'être tronqué (WPF ne wrap pas
         le texte d'en-tête par défaut, il faut personnaliser le HeaderTemplate). -->
    <Style x:Key="WrappingColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                               Padding="4,6" VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- Lignes et colonnes nettement visibles sur TOUS les DataGrid de l'application (style global,
         non dupliqué par écran) : GridLinesVisibility="All" + bordures de cellules horizontales et
         verticales dans un gris moyen cohérent (BrushGridLine, Colors.xaml), plus marqué que le simple
         soulignement gris clair précédent. -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushGridLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushGridLine}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BrushGridLine}"/>
        <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <!-- Hauteur minimale seulement : la ligne s'agrandit quand un texte passe à la ligne. -->
        <Setter Property="MinRowHeight" Value="32"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F9FAFB"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushGridLine}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <!-- Style réutilisable pour centrer horizontalement (et verticalement) le contenu des cellules
         DataGridTextColumn, appliqué à toutes les colonnes des grilles sauf la première (colonne
         d'identification de la ligne : emplacement/lieu/désignation/centrale selon l'écran), qui
         reste alignée à gauche par défaut. -->
    <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="2,4"/>
    </Style>

    <!-- Zone de saisie directement dans une cellule de grille (un clic suffit pour saisir) : fond bleuté
         léger pour signaler que la cellule est modifiable, cadre visible au survol et pendant la saisie. -->
    <Style x:Key="InlineEditTextBox" TargetType="TextBox">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#F0F7FF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="ToolTip" Value="Cliquer pour saisir, Entrée pour valider, Échap pour annuler"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#93C5FD"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#3B82F6"/>
                <Setter Property="Background" Value="White"/>
            </Trigger>
            <!-- Cellule non modifiable (valeur calculée, ou poste en lecture seule) : légèrement grisée. -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="#F3F4F6"/>
                <Setter Property="Foreground" Value="#6B7280"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="ToolTip" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Colonnes alignées à gauche (première colonne des grilles) : même retour à la ligne automatique. -->
    <Style x:Key="WrappingCellStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="4,4"/>
    </Style>

    <!-- Équivalent de CenteredCellStyle pour DataGridCheckBoxColumn (l'élément généré est une CheckBox,
         pas un TextBlock : DataGridCheckBoxColumn ne centre pas son contenu par défaut). -->
    <Style x:Key="CenteredCheckBoxCellStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Bandeau de groupe (famille) des grilles regroupées : <GroupStyle HeaderTemplate="{StaticResource
         GroupHeaderTemplate}"/>. Masqué quand le nom de groupe est vide (écrans à périodicité hors
         "Filtres G3", voir PeriodicFilterRowViewModel.DimensionFamilyLabel). -->
    <DataTemplate x:Key="GroupHeaderTemplate">
        <Border x:Name="GroupHeaderBorder" Background="{StaticResource BrushSidebar}" Padding="10,5" Margin="0,6,0,2">
            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="">
                <Setter TargetName="GroupHeaderBorder" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Colonne "Lié" : puce verte (filtre rattaché à une ligne de Commande / Inventaire) ou rouge,
         masquée quand ShowsLinkDot est faux (voir LinkedFilterRowViewModel). -->
    <DataTemplate x:Key="LinkDotCellTemplate">
        <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding LinkToolTip}">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#EF4444"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLinkedToOrder}" Value="True">
                            <Setter Property="Fill" Value="#22C55E"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowsLinkDot}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
    </DataTemplate>

    <!-- Case "Réalisé" du mois consulté (écrans à périodicité et F7 à H13). -->
    <DataTemplate x:Key="DoneCheckBoxCellTemplate">
        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsChecked="{Binding IsDoneForConsultedMonth, UpdateSourceTrigger=PropertyChanged}"
                  IsEnabled="{x:Static app:App.IsWritable}"/>
    </DataTemplate>

    <!-- Filtres d'affichage dans le bas du bandeau des titres (voir NameDimensionFilter, propriété
         HeaderFilter du ViewModel de l'écran) : "contient" sur le nom, liste des dimensions présentes. -->
    <DataTemplate x:Key="NameFilterHeaderTemplate">
        <StackPanel>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Padding="4,2"/>
            <TextBox Margin="2,4,2,0" ToolTip="N'afficher que les filtres dont le nom contient ce texte"
                     Text="{Binding DataContext.HeaderFilter.NameFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DimensionFilterHeaderTemplate">
        <StackPanel>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Padding="4,2"/>
            <ComboBox Margin="2,4,2,0" ToolTip="N'afficher que les filtres de cette dimension"
                      ItemsSource="{Binding DataContext.HeaderFilter.DimensionOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      SelectedItem="{Binding DataContext.HeaderFilter.SelectedDimension, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
