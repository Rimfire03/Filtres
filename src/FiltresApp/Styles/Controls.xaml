<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:FiltresApp"
                    xmlns:conv="clr-namespace:FiltresApp.Converters">

    <!-- Palette et controles generiques : paquet partage TomLine.UI.Wpf (App.xaml fusionne le theme complet).
         Ce fichier ne garde que les styles propres a FiltresApp. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/TomLine.UI.Wpf;component/Themes/Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <!-- Bouton Mode Édition (bascule rouge désactivé / vert activé avec retour visuel) -->
    <Style x:Key="EditModeButtonStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#0F172A" Opacity="0.12" BlurRadius="6" Direction="270" ShadowDepth="1"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CanManageVarieties}" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding CanManageViews}" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!-- En-tête de colonne DataGrid qui passe à la ligne au lieu d'être tronqué -->
    <Style x:Key="WrappingColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BrushGridHeaderBg}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushGridLine}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                               Padding="6,6" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Cellule centrée -->
    <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="4,4"/>
    </Style>

    <!-- Colonne "Réf. roulement volute" (module Roulements) : case noire pleine quand le type de centrale
         est "Entraînement direct" (pas de roulement volute dans ce cas, voir BearingRowViewModel.IsDirectDrive). -->
    <Style x:Key="VoluteCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDirectDrive}" Value="True">
                <Setter Property="Background" Value="Black"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Saisie directe dans une cellule -->
    <Style x:Key="InlineEditTextBox" TargetType="TextBox">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource BrushPrimaryLight}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="ToolTip" Value="Cliquer pour saisir, Entrée pour valider, Échap pour annuler"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
                <Setter Property="Background" Value="White"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="#F1F5F9"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="ToolTip" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Colonnes alignées à gauche -->
    <Style x:Key="WrappingCellStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="8,4"/>
    </Style>

    <!-- Colonne "Filtres" (écrans G4 plissé / G4 plan / G3 / Charbon, PeriodicFilterView) et "Nom de la
         centrale" (BeltView, BearingView) : même style que
         WrappingCellStyle, en gras (voir aussi PrintService.NewCell pour l'impression). -->
    <Style x:Key="BoldWrappingCellStyle" TargetType="TextBlock" BasedOn="{StaticResource WrappingCellStyle}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Flash vert pour confirmer l'enregistrement d'un changement (CellStyle des grilles Filtres F7 à H14,
         Courroies, Roulements ; voir TriggerSavedFlash dans leurs RowViewModel, qui maintient IsFlashing à
         true 0,5 s = fondu d'apparition 0,2 s + vert plein 0,3 s, puis fondu de disparition 0,2 s) : calque
         vert posé au-dessus du fond de chaque cellule, dont seule l'opacité est animée - quel que soit le fond
         en dessous (couleur de ligne, sélection), qui n'est jamais modifié. Porté par les cellules et non par
         la ligne, car le fond de sélection des cellules masquerait celui de la ligne. -->
    <Style x:Key="FlashingCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="FlashOverlay" Background="#FF00C853" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FlashOverlay" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FlashOverlay" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Case à cocher centrée dans DataGrid -->
    <Style x:Key="CenteredCheckBoxCellStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <!-- Bandeau de groupe de famille -->
    <DataTemplate x:Key="GroupHeaderTemplate">
        <Border x:Name="GroupHeaderBorder" Background="{StaticResource BrushSidebarHover}"
                CornerRadius="6" Padding="12,6" Margin="0,8,0,3">
            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Name}" Value="">
                <Setter TargetName="GroupHeaderBorder" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Colonne "Lié" : puce ronde stylée -->
    <DataTemplate x:Key="LinkDotCellTemplate">
        <Border Width="12" Height="12" CornerRadius="6" ToolTip="{Binding LinkToolTip}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLinkedToOrder}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowsLinkDot}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </DataTemplate>

    <!-- Case "Réalisé" -->
    <DataTemplate x:Key="DoneCheckBoxCellTemplate">
        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsChecked="{Binding IsDoneForConsultedMonth, UpdateSourceTrigger=PropertyChanged}"
                  IsEnabled="{x:Static app:App.IsWritable}"/>
    </DataTemplate>

    <!-- Filtres d'affichage sous les en-têtes -->
    <DataTemplate x:Key="NameFilterHeaderTemplate">
        <StackPanel>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Padding="4,2" FontWeight="SemiBold"/>
            <TextBox Margin="2,4,2,0" ToolTip="N'afficher que les filtres dont le nom contient ce texte"
                     Text="{Binding DataContext.HeaderFilter.NameFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NameSearchHeaderTemplate">
        <StackPanel>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Padding="4,2" FontWeight="SemiBold"/>
            <TextBox Margin="2,4,2,0" ToolTip="N'afficher que les centrales dont le nom contient ce texte"
                     Text="{Binding DataContext.NameSearch.NameFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DestinationFilterHeaderTemplate">
        <DataTemplate.Resources>
            <conv:SubtractConverter x:Key="Subtract"/>
        </DataTemplate.Resources>
        <StackPanel>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Padding="4,2" FontWeight="SemiBold"/>
            <TextBox Margin="0,4,0,0" HorizontalAlignment="Left" ToolTip="N'afficher que les lignes dont la destination contient ce texte"
                     Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Converter={StaticResource Subtract}, ConverterParameter=10}"
                     Text="{Binding DataContext.HeaderFilter.NameFilter, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DimensionFilterHeaderTemplate">
        <StackPanel>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Padding="4,2" FontWeight="SemiBold"/>
            <ComboBox Margin="2,4,2,0" ToolTip="N'afficher que les filtres de cette dimension"
                      ItemsSource="{Binding DataContext.HeaderFilter.DimensionOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      SelectedItem="{Binding DataContext.HeaderFilter.SelectedDimension, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
