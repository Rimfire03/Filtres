<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BrushPrimary" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#DC2626"/>
    <SolidColorBrush x:Key="BrushDangerDark" Color="#B91C1C"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#16A34A"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#D97706"/>

    <SolidColorBrush x:Key="BrushBackground" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="#111827"/>
    <SolidColorBrush x:Key="BrushSidebarHover" Color="#1F2937"/>
    <SolidColorBrush x:Key="BrushSidebarSelected" Color="#2563EB"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="BrushTextOnDark" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#E5E7EB"/>

    <!-- Gris moyen dédié aux lignes de grille des DataGrid (bordures de cellules/en-têtes) : plus
         marqué que BrushBorder (#E5E7EB, utilisé pour les contours de cartes/champs) afin que les
         lignes et colonnes des tableaux restent clairement visibles sans être agressives. -->
    <SolidColorBrush x:Key="BrushGridLine" Color="#9CA3AF"/>

</ResourceDictionary>
