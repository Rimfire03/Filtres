<Application x:Class="FiltresApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FiltresApp"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels"
             xmlns:views="clr-namespace:FiltresApp.Views"
             xmlns:vmf="clr-namespace:FiltresApp.ViewModels.Filtres"
             xmlns:viewsf="clr-namespace:FiltresApp.Views.Filtres"
             xmlns:conv="clr-namespace:FiltresApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <conv:RowColorIdToBrushConverter x:Key="RowColorIdToBrush"/>

            <DataTemplate DataType="{x:Type vmf:PeriodicFilterListViewModel}">
                <viewsf:PeriodicFilterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmf:K7ListViewModel}">
                <viewsf:K7View/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmf:InventoryListViewModel}">
                <viewsf:InventoryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmf:OrderListViewModel}">
                <viewsf:OrderView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModuleSettingsViewModel}">
                <views:ModuleSettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
                <views:StatisticsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HelpViewModel}">
                <views:HelpView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmf:FilterVarietyListViewModel}">
                <viewsf:FilterVarietyListView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmf:PeriodicViewListViewModel}">
                <viewsf:PeriodicViewListView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmf:DynamicFilterListViewModel}">
                <viewsf:DynamicFilterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmf:BeltListViewModel}">
                <viewsf:BeltView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vmf:BearingListViewModel}">
                <viewsf:BearingView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
