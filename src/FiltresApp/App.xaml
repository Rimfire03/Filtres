<Application x:Class="FiltresApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FiltresApp"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels"
             xmlns:views="clr-namespace:FiltresApp.Views"
             xmlns:conv="clr-namespace:FiltresApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>

            <DataTemplate DataType="{x:Type vm:PeriodicFilterListViewModel}">
                <views:PeriodicFilterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OpacimetricFilterListViewModel}">
                <views:OpacimetricFilterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:K7ListViewModel}">
                <views:K7View/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventoryListViewModel}">
                <views:InventoryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrderListViewModel}">
                <views:OrderView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
