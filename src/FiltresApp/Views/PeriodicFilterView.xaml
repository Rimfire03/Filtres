<UserControl x:Class="FiltresApp.Views.PeriodicFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels"
             d:DataContext="{d:DesignInstance vm:PeriodicFilterListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource HeaderText}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Ajouter" Style="{StaticResource PrimaryButton}" Command="{Binding AddFilterCommand}"/>
            <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Command="{Binding EditFilterCommand}"/>
            <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteFilterCommand}"/>
            <Button Content="Enregistrer un remplacement" Style="{StaticResource PrimaryButton}" Command="{Binding MarkReplacementCommand}"/>
            <Button Content="Imprimer" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}"/>
            <Button Content="Imprimer le mois consulté" Style="{StaticResource SecondaryButton}" Command="{Binding PrintMonthCommand}"/>
            <Button Content="Exporter l'année en Excel" Style="{StaticResource SecondaryButton}" Command="{Binding ExportExcelYearCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Filtrer par mois :" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding MonthFilterOptions}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MonthFilter}" Width="150"/>
            <Button Content="Réinitialiser le filtre" Style="{StaticResource SecondaryButton}" Command="{Binding ResetFilterCommand}" Margin="12,0,0,0"/>

            <TextBlock Text="Mois consulté (case à cocher) :" VerticalAlignment="Center" Margin="24,0,8,0" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding MonthOptions}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding ConsultedMonth}" Width="130"/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" AutoGenerateColumns="False"
                  ColumnHeaderStyle="{StaticResource WrappingColumnHeaderStyle}">
            <DataGrid.Resources>
                <!-- Menu contextuel "Changé tous les 15 jours" : uniquement proposé sur l'écran
                     "Filtres G4 plissés" (voir PeriodicFilterRowViewModel.ShowChangedEvery15DaysOption).
                     Le DataContext du ContextMenu est hérité du PlacementTarget (la ligne), donc des
                     mêmes propriétés que celles de la ligne (comportement WPF depuis .NET 4.5). -->
                <Style TargetType="DataGridRow">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Changé tous les 15 jours (besoin doublé)"
                                          IsCheckable="True"
                                          Visibility="{Binding ShowChangedEvery15DaysOption, Converter={StaticResource BoolToVis}}"
                                          IsChecked="{Binding ChangedEvery15Days, UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Contrairement à l'option "15 jours" ci-dessus (G4 plissé uniquement),
                                     "Consulter l'historique..." est proposé sur toutes les catégories. -->
                                <MenuItem Header="Consulter l'historique..." Command="{Binding ShowHistoryCommand}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Surlignage jaune léger des filtres "Changé tous les 15 jours" (même pattern
                             que le surlignage rouge "déjà rattaché" de FilterLinkWindow.xaml). -->
                        <DataTrigger Binding="{Binding ChangedEvery15Days}" Value="True">
                            <Setter Property="Background" Value="#FFF9C4"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding LocationColumnLabel}" Binding="{Binding Location}" Width="2.2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Dimension" Binding="{Binding Dimension}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MediaType}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="Qté en place" Binding="{Binding QuantityInPlace}" Width="0.7*" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="Périodicité" Binding="{Binding PeriodicityDisplay}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="Prochaine échéance" Binding="{Binding NextDueDate, StringFormat='MM/yyyy'}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="Dernier changement" Binding="{Binding LastDoneDate, StringFormat='dd/MM/yyyy'}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTemplateColumn Header="Réalisé" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsDoneForConsultedMonth, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Date du changement" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DateDoneForConsultedMonth, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" HorizontalAlignment="Center" HorizontalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
