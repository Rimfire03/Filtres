<UserControl x:Class="FiltresApp.Views.K7View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels"
             d:DataContext="{d:DesignInstance vm:K7ListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedLocations" Source="{Binding Locations}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="FamilyGroupLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource HeaderText}"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="+ Ajouter un lieu" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"/>
                <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}"/>
                <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}"/>
                <Button Content="Imprimer" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Source={StaticResource GroupedLocations}}"
                      SelectedItem="{Binding SelectedLocation}" IsReadOnly="True"
                      AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource WrappingColumnHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lieu" Binding="{Binding Lieu}" Width="3*"/>
                    <DataGridTextColumn Header="N° porte" Binding="{Binding NumeroPorte}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                    <DataGridTextColumn Header="Changement réalisé" Binding="{Binding ChangementRealise, StringFormat='dd/MM/yyyy'}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                    <DataGridTextColumn Header="Nb de filtres" Binding="{Binding NbFiltres}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                </DataGrid.Columns>
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSidebar}" Padding="10,5" Margin="0,6,0,2">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
            </DataGrid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Familles K7" Style="{StaticResource HeaderText}" FontSize="16"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="+ Ajouter" Style="{StaticResource PrimaryButton}" Command="{Binding AddFamilyCommand}"/>
                <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Command="{Binding EditFamilyCommand}"/>
                <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteFamilyCommand}"/>
            </StackPanel>

            <ListBox Grid.Row="2" ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PeriodicityDisplay, StringFormat='Périodicité : {0}'}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
