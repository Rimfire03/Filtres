<UserControl x:Class="FiltresApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels"
             xmlns:app="clr-namespace:FiltresApp"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ScrollViewer Margin="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" Style="{StaticResource HeaderText}"/>

            <!-- Base de données : versions, taille, et les deux chemins enregistrés ensemble. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Base de données" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource SectionText}">
                        <Run Text="Logiciel"/><Run Text=" "/><Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Base v"/><Run Text="{Binding DatabaseVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  ·  "/><Run Text="{Binding DatabaseSizeDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <TextBlock Text="Fichier de la base (chemin relatif au dossier de l'exécutable pour rester portable, ou absolu) :" Style="{StaticResource SectionText}" Margin="0,10,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseDatabasePathCommand}"/>
                        <TextBox Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="Dossier d'export PDF (remplace le chemin réseau de l'ancienne macro Excel) :" Style="{StaticResource SectionText}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowsePdfExportPathCommand}"/>
                        <TextBox Text="{Binding PdfExportPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <Button Content="Enregistrer les paramètres" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

            <!-- Logo de l'entreprise (base de données, commun à tous les postes). -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Logo de l'entreprise" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Affiché dans la barre latérale et en tête des impressions/exports PDF. PNG, JPG, BMP ou GIF, 2 Mo max." Style="{StaticResource SectionText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="6" Margin="0,0,0,8" HorizontalAlignment="Left"
                            Visibility="{Binding LogoImage, Converter={StaticResource NullToCollapsed}}">
                        <Image Source="{Binding LogoImage}" MaxHeight="80" MaxWidth="260" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Choisir un logo..." Style="{StaticResource SecondaryButton}" Command="{Binding ChooseLogoCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                        <Button Content="Retirer le logo" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RemoveLogoCommand}"
                                IsEnabled="{x:Static app:App.IsWritable}" Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LogoStatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

            <!-- Réglages de comportement, regroupés et réduits à une ligne chacun. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Comportement" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox Content="Rattacher des filtres... : n'afficher par défaut que les dimensions correspondantes (±5 mm)"
                              IsChecked="{Binding LinkDimensionFilterEnabled}" Margin="0,0,0,8"/>
                    <CheckBox Content="Autoriser la création de nouvelles variétés de filtres « F7 à H14 » (mode édition, remis à non à chaque lancement)"
                              IsChecked="{Binding AllowFilterVarietyCreation}" Margin="0,0,0,8"/>
                    <CheckBox Content="Vérifier automatiquement les mises à jour au démarrage"
                              IsChecked="{Binding AutoUpdateEnabled}"/>
                </StackPanel>
            </Border>

            <!-- Mises à jour : action + statut, séparés du réglage automatique ci-dessus. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mises à jour" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Vérifier maintenant" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Télécharger et installer" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding InstallUpdateCommand}" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

            <!-- Export Excel de l'année. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Export Excel de l'année" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Un classeur .xlsx dans le dossier d'export PDF : une feuille par onglet de filtres (G4 plissés, G4 plan, G3, Charbon, et chaque variété « F7 à H14 »). Liste K7, Inventaire et Commande ne sont pas exportés." Style="{StaticResource SectionText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Année à exporter :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding YearContext.AvailableYears}" SelectedItem="{Binding SelectedExportYear}" HorizontalAlignment="Left" Width="120"/>
                    </DockPanel>
                    <Button Content="Exporter l'année en Excel" Style="{StaticResource PrimaryButton}" Command="{Binding ExportExcelYearCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding ExportStatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

            <!-- Suppression définitive de l'historique d'une année, par groupe de filtres. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Supprimer l'historique d'une année" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Supprime définitivement les remplacements de l'année choisie (les filtres sont conservés). Une sauvegarde est faite avant." Style="{StaticResource SectionText}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <TextBlock Text="G4 plissés, G4 plan, G3, Charbon" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PeriodicHistoryYears}" SelectedItem="{Binding SelectedPeriodicHistoryYear}" Width="120"/>
                        <Button Content="Supprimer" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                                Command="{Binding DeletePeriodicHistoryCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                    </StackPanel>

                    <TextBlock Text="Filtres F7 à H14 (toutes variétés)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding DynamicHistoryYears}" SelectedItem="{Binding SelectedDynamicHistoryYear}" Width="120"/>
                        <Button Content="Supprimer" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                                Command="{Binding DeleteDynamicHistoryCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding HistoryStatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
