<UserControl x:Class="FiltresApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels"
             xmlns:app="clr-namespace:FiltresApp"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <DockPanel Margin="24">
        <!-- En-tête : titre, résumé (même présentation que la page Statistiques). -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Paramètres" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Modules, base de données et sauvegardes, exports, mises à jour." Style="{StaticResource SectionText}" Margin="0,4,0,0"/>
            <UniformGrid Columns="4" Margin="0,12,0,0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel>
                        <TextBlock Text="Logiciel" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="{Binding CurrentVersion, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel>
                        <TextBlock Text="Base de données (version)" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="{Binding DatabaseVersion, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel>
                        <TextBlock Text="Taille de la base" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="{Binding DatabaseSizeDisplay, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel>
                        <TextBlock Text="Canal de mise à jour" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="{Binding UpdateChannel, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            </UniformGrid>
        </StackPanel>

        <TabControl>
            <TabItem Header="Modules">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Modules activables (barre latérale) : la roue dentée à côté de chaque case ouvre les
                 réglages propres à ce module (voir ModuleSettingsView.xaml). En premier dans la page :
                 c'est le réglage le plus consulté. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="Modules" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" Content="Activer le module « Filtre » (G4, G3, Charbon, F7 à H14, Liste K7, Inventaire, Commande)" IsChecked="{Binding ShowFiltresModule}" IsEnabled="{Binding CanToggleFiltresModule}" VerticalAlignment="Center"
                                  ToolTip="Nécessite une licence couvrant ce module"/>
                        <Button DockPanel.Dock="Right" Content="⚙" FontSize="15" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFiltreModuleSettingsCommand}" ToolTip="Paramètres du module « Filtre »"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" Content="Activer le module « Courroies »" IsChecked="{Binding ShowBeltsModule}" IsEnabled="{Binding CanToggleBeltsModule}" VerticalAlignment="Center"
                                  ToolTip="Nécessite une licence couvrant ce module"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" Content="Activer le module « Roulements »" IsChecked="{Binding ShowBearingsModule}" IsEnabled="{Binding CanToggleBearingsModule}" VerticalAlignment="Center"
                                  ToolTip="Nécessite une licence couvrant ce module"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" Content="Activer le module « Suivi ZAC »" IsChecked="{Binding ShowZacModule}" IsEnabled="{Binding CanToggleZacModule}" VerticalAlignment="Center"
                                  ToolTip="Module Suivi ZAC : nécessite la fonctionnalité « suivi-zac » dans votre licence" ToolTipService.ShowOnDisabled="True"/>
                        <Button DockPanel.Dock="Right" Content="⚙" FontSize="15" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding OpenZacModuleSettingsCommand}" ToolTip="Paramètres du module « Suivi ZAC »"/>
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" Content="Activer le module « MultiSite » (plusieurs sites aux données séparées)" IsChecked="{Binding ShowMultiSiteModule}" IsEnabled="{Binding CanToggleMultiSiteModule}" VerticalAlignment="Center"
                                  ToolTip="{Binding MultiSiteToolTip}" ToolTipService.ShowOnDisabled="True"/>
                        <Button DockPanel.Dock="Right" Content="⚙" FontSize="15" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding OpenMultiSiteModuleSettingsCommand}" ToolTip="Paramètres du module « MultiSite »"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <!-- Licence : masquée en licence gratuite (flag de build ou licence.ini), rien à déconnecter. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="{Binding ShowLicenseCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Licence" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding LicenseStatusText}" Style="{StaticResource SectionText}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowLicenseButtons, Converter={StaticResource BoolToVis}}">
                        <Button Content="Changer de licence" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ChangeLicenseCommand}" HorizontalAlignment="Left"/>
                        <Button Content="Se déconnecter" Style="{StaticResource DangerButton}"
                                Command="{Binding DisconnectLicenseCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Base de données">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Base de données : versions, taille, et les deux chemins enregistrés ensemble. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Base de données" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource SectionText}">
                        <Run Text="Logiciel"/><Run Text=" "/><Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  ·  Base v"/><Run Text="{Binding DatabaseVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="  ·  "/><Run Text="{Binding DatabaseSizeDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <!-- Date de la dernière saisie, relevée dans la base (commune à tous les postes). -->
                    <TextBlock Text="{Binding LastWriteDisplay}" Style="{StaticResource SectionText}" Margin="0,4,0,0"/>

                    <!-- Mode de stockage (fichier ou serveur) et accès à la page de réglages avancés. -->
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Réglages BDD avancés..." Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenDatabaseAdvancedSettingsCommand}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DatabaseModeDisplay, Mode=OneWay}" Style="{StaticResource SectionText}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>

                    <TextBlock Text="Fichier de la base (chemin relatif au dossier de l'exécutable pour rester portable, ou absolu) :" Style="{StaticResource SectionText}" Margin="0,10,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseDatabasePathCommand}"/>
                        <TextBox Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <!-- Sauvegarde de la base : export / import manuels et gestion des sauvegardes automatiques. -->
                    <Separator Margin="0,2,0,10"/>
                    <TextBlock Text="Sauvegarde" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Exporte une copie complète de la base (nommée save_db_filtre_DATE_VERSION.db), à garder ou transférer sur un autre poste. L'import ouvre un sélecteur de fichier, puis restaure la sauvegarde choisie en vérifiant sa version et en la mettant à jour si besoin. Les sauvegardes automatiques sont rangées dans le dossier Save DB." Style="{StaticResource SectionText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="Exporter la base de données" Style="{StaticResource PrimaryButton}" Command="{Binding ExportDatabaseCommand}" Margin="0,0,8,8"/>
                        <Button Content="Importer une sauvegarde..." Style="{StaticResource DangerButton}" Command="{Binding ImportDatabaseCommand}" Margin="0,0,8,8" IsEnabled="{x:Static app:App.IsWritable}"/>
                        <Button Content="Gestion des sauvegardes automatiques..." Style="{StaticResource SecondaryButton}" Command="{Binding OpenBackupManagerCommand}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding BackupStatusMessage}" TextWrapping="Wrap" Margin="0,2,0,10" Foreground="{StaticResource BrushPrimary}"/>

                    <Button Content="Enregistrer les paramètres" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Calcul de charge : coefficient de correction par vue de changement de filtre périodique. -->
            <TabItem Header="Calcul de charge">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Coefficient de correction par vue" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource SectionText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Chaque filtre périodique compte pour le coefficient de sa vue dans la charge des mois : couleurs des mois (rouge chargé, vert peu chargé) à l'édition d'un filtre et charge pondérée des statistiques. Valeur de base 1,0 ; réglable par pas de 0,1 avec + et -. Un coefficient de 1,5 signifie qu'un filtre de cette vue représente une fois et demie le travail d'un filtre à 1,0. Enregistré tout de suite, commun à tous les postes."/>
                                <ItemsControl ItemsSource="{Binding LoadCoefficients}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="Remettre à 1,0" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                                        Command="{Binding ResetCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                                                <Button DockPanel.Dock="Right" Content="+" Width="36" FontWeight="Bold" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                                        Command="{Binding IncreaseCommand}" IsEnabled="{Binding CanIncrease}" ToolTip="Augmenter de 0,1"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CoefficientText}" Width="48" TextAlignment="Center" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <Button DockPanel.Dock="Right" Content="-" Width="36" FontWeight="Bold" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DecreaseCommand}" IsEnabled="{Binding CanDecrease}" ToolTip="Diminuer de 0,1"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Coefficient de correction de chaque mois, en % : un mois à 80 % a une capacité réduite. -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Coefficient de correction par mois" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource SectionText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Chaque mois peut avoir un coefficient en % (100 % par défaut, pas de 5 %). Un mois à 80 % a une capacité réduite : une charge égale à 80 % de la normale y est considérée comme une charge de 100 %. Pris en compte dans les couleurs des mois à l'édition d'un filtre et dans le graphique de charge pondérée du tableau de bord. Enregistré tout de suite, commun à tous les postes."/>
                                <ItemsControl ItemsSource="{Binding MonthPercents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6" LastChildFill="True" MaxWidth="420" HorizontalAlignment="Left">
                                                <Button DockPanel.Dock="Right" Content="+" Width="36" FontWeight="Bold" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"
                                                        Command="{Binding IncreaseCommand}" IsEnabled="{Binding CanIncrease}" ToolTip="Augmenter de 5 %"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Width="60" TextAlignment="Center" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <Button DockPanel.Dock="Right" Content="-" Width="36" FontWeight="Bold" Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DecreaseCommand}" IsEnabled="{Binding CanDecrease}" ToolTip="Diminuer de 5 %"/>
                                                <TextBlock Text="{Binding MonthName}" VerticalAlignment="Center" Width="120"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Remettre tous les mois à 100 %" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding ResetMonthPercentsCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Commande : mode de calcul du besoin de commande, propre à chaque site. -->
            <TabItem Header="Commande">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Calcul du besoin de commande" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource SectionText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Réglage propre au site courant : chaque site peut calculer son besoin différemment. S'applique aux familles de Commande et Inventaire dont le besoin est calculé à partir des filtres rattachés. Enregistré tout de suite."/>

                                <RadioButton GroupName="OrderNeedMode" Content="Deux livraisons par an (date de livraison + mois de sécurité)"
                                             IsChecked="{Binding OrderDeliveryMode, Mode=TwoWay}" IsEnabled="{x:Static app:App.IsWritable}" Margin="0,0,0,6"/>
                                <StackPanel Margin="24,0,0,10" IsEnabled="{Binding OrderDeliveryMode}">
                                    <ItemsControl ItemsSource="{Binding OrderDeliveries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Livraison en" VerticalAlignment="Center" Width="170"/>
                                                    <ComboBox Width="140" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                              ItemsSource="{Binding DataContext.OrderMonthChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedValue="{Binding Month, Mode=TwoWay}"/>
                                                    <Button Content="Retirer" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RemoveCommand}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Ajouter une livraison" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                            Command="{Binding AddOrderDeliveryCommand}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Mois de changement de sécurité" VerticalAlignment="Center" Width="170"/>
                                        <ComboBox Width="80" ItemsSource="{Binding SafetyMonthChoices}" SelectedItem="{Binding OrderSafetyMonths, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <RadioButton GroupName="OrderNeedMode" Content="Inventaire à chaque changement (1 changement + une marge en %)"
                                             IsChecked="{Binding OrderEveryChangeMode, Mode=TwoWay}" IsEnabled="{x:Static app:App.IsWritable}" Margin="0,0,0,6"/>
                                <StackPanel Margin="24,0,0,10" Orientation="Horizontal" IsEnabled="{Binding OrderEveryChangeMode}">
                                    <TextBlock Text="Sécurité (% d'un changement)" VerticalAlignment="Center" Width="170"/>
                                    <ComboBox Width="80" ItemsSource="{Binding SafetyPercentChoices}" SelectedItem="{Binding OrderSafetyPercent, Mode=TwoWay}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding OrderNeedSummary}" Style="{StaticResource SectionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Utilisateurs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Utilisateurs autorisés en lecture/écriture" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource SectionText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Text="Les sessions Windows de la liste de droite peuvent modifier les données ; les autres sont en lecture seule. Les changements sont enregistrés immédiatement. Tant que la liste est vide, le premier utilisateur qui se connecte y est ajouté. Un nom « @domaine » autorise toutes les sessions de ce domaine."/>
                                <CheckBox Content="Activer la gestion des utilisateurs (désactivée par défaut : tout le monde peut modifier les données)"
                                          IsChecked="{Binding AccessEnabled}" IsEnabled="{Binding CanToggleAccess}" Margin="0,0,0,8"
                                          ToolTip="À l'activation, si la liste de droite est vide, la session courante en devient le premier utilisateur"/>
                                <TextBlock Text="{Binding AccessIdentityText}" Style="{StaticResource SectionText}" Margin="0,0,0,10"/>
                                <Button Content="S'ajouter en utilisateur lecture/écriture (mot de passe)..." Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelfEnrollWithPasswordCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Visibility="{Binding ShowSelfEnroll, Converter={StaticResource BoolToVis}}"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Utilisateurs connus" Style="{StaticResource SectionText}" Margin="0,0,0,4"/>
                                        <ListBox ItemsSource="{Binding KnownUsers}" SelectedItem="{Binding SelectedKnownUser}" Height="240"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,20,12,0">
                                        <Button Content="Ajouter &gt;&gt;" Style="{StaticResource SecondaryButton}" Command="{Binding AddAccessUserCommand}"
                                                IsEnabled="{Binding CanEditAccess}" Margin="0,0,0,8"/>
                                        <Button Content="&lt;&lt; Supprimer" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveAccessUserCommand}"
                                                IsEnabled="{Binding CanEditAccess}" Margin="0,0,0,8"/>
                                        <Button Content="Supprimer l'utilisateur" Style="{StaticResource DangerButton}" Command="{Binding DeleteAccessUserCommand}"
                                                IsEnabled="{Binding CanEditAccess}"
                                                ToolTip="Supprime définitivement l'utilisateur sélectionné de la liste"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Utilisateurs en lecture/écriture" Style="{StaticResource SectionText}" Margin="0,0,0,4"/>
                                        <ListBox ItemsSource="{Binding WriterUsers}" SelectedItem="{Binding SelectedWriterUser}" Height="240"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Ajouter un utilisateur pas encore connecté (nom de session, DOMAINE\nom ou @domaine), puis Entrée :" Style="{StaticResource SectionText}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditAccess}" Margin="0,0,0,10"
                                         ToolTip="Entrée pour créer l'utilisateur">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding CreateAccessUserCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="{Binding AccessStatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Exports et logo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Export PDF / Excel : dossier de destination des exports. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Export PDF" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Dossier d'export PDF :" Style="{StaticResource SectionText}" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowsePdfExportPathCommand}"/>
                        <TextBox Text="{Binding PdfExportPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <Button Content="Enregistrer le dossier" Style="{StaticResource PrimaryButton}" Command="{Binding SavePdfExportPathCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding PdfStatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>
            <!-- Logo de l'entreprise (base de données, commun à tous les postes). -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Logo de l'entreprise" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Affiché dans la barre latérale et en tête des impressions/exports PDF. PNG, JPG, BMP ou GIF, 2 Mo max." Style="{StaticResource SectionText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8" HorizontalAlignment="Left"
                            Visibility="{Binding LogoImage, Converter={StaticResource NullToCollapsed}}">
                        <Image Source="{Binding LogoImage}" MaxHeight="80" MaxWidth="260" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Choisir un logo..." Style="{StaticResource SecondaryButton}" Command="{Binding ChooseLogoCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                        <Button Content="Retirer le logo" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RemoveLogoCommand}"
                                IsEnabled="{x:Static app:App.IsWritable}" Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LogoStatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Mises à jour">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Mises à jour : réglage automatique + action manuelle + statut. -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mises à jour" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox Content="Vérifier automatiquement les mises à jour au démarrage"
                              IsChecked="{Binding AutoUpdateEnabled}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                ToolTip="Main : versions stables (branche main). Dev : versions de test (branche dev, tag en -dev).">
                        <TextBlock Text="Canal" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Width="120" ItemsSource="{Binding UpdateChannelChoices}"
                                  SelectedItem="{Binding UpdateChannel}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Vérifier maintenant" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Télécharger et installer" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding InstallUpdateCommand}" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>
            <!-- Contrat de licence utilisateur final : relecture seule (accepté au premier lancement, voir App.Eula.cs). -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Contrat de licence" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Contrat de licence utilisateur final (CLUF) accepté lors de l'installation du logiciel." Style="{StaticResource SectionText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Button Content="Lire le contrat de licence (CLUF)" Style="{StaticResource SecondaryButton}" Command="{Binding ShowEulaCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
