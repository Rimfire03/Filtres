<UserControl x:Class="FiltresApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels"
             xmlns:app="clr-namespace:FiltresApp"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ScrollViewer Margin="24">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" Style="{StaticResource HeaderText}"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Versions" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource SectionText}">
                        <Run Text="Version du logiciel :"/>
                        <Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SectionText}" Margin="0,2,0,0">
                        <Run Text="Version de la base de données :"/>
                        <Run Text="{Binding DatabaseVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Emplacement de la base de données" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Chemin relatif au dossier de l'exécutable pour rester portable, ou chemin absolu." Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseDatabasePathCommand}"/>
                        <TextBox Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dossier d'export PDF" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Remplace le chemin réseau codé en dur de l'ancienne macro Excel (exportcmd)." Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowsePdfExportPathCommand}"/>
                        <TextBox Text="{Binding PdfExportPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Button Content="Enregistrer les paramètres" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,24" Foreground="{StaticResource BrushPrimary}"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Logo de l'entreprise" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Enregistré dans la base de données (commun à tous les postes). Affiché en haut de la barre latérale et en tête des impressions et des exports PDF. Formats PNG, JPG, BMP ou GIF, 2 Mo au maximum." Style="{StaticResource SectionText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="6" Margin="0,0,0,8" HorizontalAlignment="Left"
                            Visibility="{Binding LogoImage, Converter={StaticResource NullToCollapsed}}">
                        <Image Source="{Binding LogoImage}" MaxHeight="80" MaxWidth="260" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Choisir un logo..." Style="{StaticResource SecondaryButton}" Command="{Binding ChooseLogoCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                        <Button Content="Retirer le logo" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding RemoveLogoCommand}"
                                IsEnabled="{x:Static app:App.IsWritable}" Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LogoStatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Rattachement des filtres" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Fenêtre « Rattacher des filtres... » de l'écran Commande. Décoché : tous les filtres sont affichés dès l'ouverture." Style="{StaticResource SectionText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <CheckBox Content="N'afficher par défaut que les filtres de dimension correspondante (±5 mm, largeur et hauteur interchangeables)"
                              IsChecked="{Binding LinkDimensionFilterEnabled}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mises à jour" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <CheckBox Content="Vérifier automatiquement les mises à jour au démarrage"
                              IsChecked="{Binding AutoUpdateEnabled}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Vérifier maintenant" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Télécharger et installer" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding InstallUpdateCommand}" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateStatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Export Excel de l'année" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Génère un classeur .xlsx (une feuille par catégorie : G4 plissés, G4 plan, G3, F7-H13, Charbon) pour l'année sélectionnée, dans le même dossier que les exports PDF." Style="{StaticResource SectionText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding YearContext.AvailableYears}" SelectedItem="{Binding YearContext.Year}" HorizontalAlignment="Left" Width="120"/>
                    </DockPanel>
                    <Button Content="Exporter l'année en Excel" Style="{StaticResource PrimaryButton}" Command="{Binding ExportExcelYearCommand}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding ExportStatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Supprimer l'historique d'une année" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Supprime définitivement les remplacements enregistrés pour l'année choisie. Les filtres eux-mêmes sont conservés. Seules les années ayant un historique sont proposées. Une sauvegarde de la base est faite avant chaque suppression." Style="{StaticResource SectionText}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <TextBlock Text="Filtres G4 plissés, G4 plan, G3 et Charbon" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PeriodicHistoryYears}" SelectedItem="{Binding SelectedPeriodicHistoryYear}" Width="120"/>
                        <Button Content="Supprimer l'historique de cette année" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                                Command="{Binding DeletePeriodicHistoryCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                    </StackPanel>

                    <TextBlock Text="Filtres F7 à H13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding OpacimetricHistoryYears}" SelectedItem="{Binding SelectedOpacimetricHistoryYear}" Width="120"/>
                        <Button Content="Supprimer l'historique de cette année" Style="{StaticResource DangerButton}" Margin="12,0,0,0"
                                Command="{Binding DeleteOpacimetricHistoryCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding HistoryStatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource BrushPrimary}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
