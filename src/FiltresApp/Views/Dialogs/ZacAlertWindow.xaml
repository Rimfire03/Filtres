<Window x:Class="FiltresApp.Views.Dialogs.ZacAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suivi ZAC - contrôles à effectuer" Width="720" Height="480" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bandeau : rouge si au moins un contrôle est dépassé, orange sinon. -->
        <Border x:Name="Banner" Grid.Row="0" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <TextBlock x:Name="BannerText" Foreground="White" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
        </Border>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LevelName}" Value="Overdue">
                            <Setter Property="Foreground" Value="#B91C1C"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelName}" Value="Approaching">
                            <Setter Property="Foreground" Value="#B45309"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pièce" Binding="{Binding Item}" Width="*"/>
                <DataGridTextColumn Header="Type de ZAC" Binding="{Binding ZacType}" Width="1.1*"/>
                <DataGridTextColumn Header="Prochain contrôle" Binding="{Binding NextText}" Width="130"/>
                <DataGridTextColumn Header="Échéance" Binding="{Binding DelayText}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Ouvrir le module Suivi ZAC" Style="{StaticResource PrimaryButton}" Click="OnOpenModule"/>
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
