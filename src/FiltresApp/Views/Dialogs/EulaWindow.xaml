<Window x:Class="FiltresApp.Views.Dialogs.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrat de licence utilisateur final"
        Height="640" Width="720" MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Contrat de licence utilisateur final" Style="{StaticResource HeaderText}"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}"
                   Text="Veuillez lire le contrat ci-dessous. Vous devez l'accepter pour utiliser le logiciel."/>

        <TextBox x:Name="EulaText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10"/>

        <CheckBox x:Name="AcceptCheck" Grid.Row="3" Margin="0,14,0,0"
                  Content="J'ai lu le contrat de licence utilisateur final et j'en accepte les conditions."
                  Checked="AcceptCheck_Changed" Unchecked="AcceptCheck_Changed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Je refuse" Style="{StaticResource SecondaryButton}" Width="110" Click="Decline_Click"/>
            <Button x:Name="AcceptButton" Content="J'accepte" Style="{StaticResource PrimaryButton}" Width="110" Margin="8,0,0,0"
                    IsEnabled="False" Click="Accept_Click"/>
        </StackPanel>
    </Grid>
</Window>
