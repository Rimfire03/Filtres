<Window x:Class="FiltresApp.Views.Dialogs.DynamicEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, RelativeSource={RelativeSource Self}}"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource HeaderText}" Grid.Row="0"/>

        <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FieldsPanel"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Width="100"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Width="120" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
