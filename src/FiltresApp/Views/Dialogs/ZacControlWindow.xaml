<Window x:Class="FiltresApp.Views.Dialogs.ZacControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrôle" Width="560" Height="520" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" Style="{StaticResource HeaderText}" TextWrapping="Wrap"/>
            <TextBlock Text="Commentaire (facultatif)" Style="{StaticResource SectionText}" Margin="0,10,0,4"/>
            <TextBox x:Name="CommentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Fichiers joints (facultatif) : glissez-déposez des fichiers ci-dessous"
                   Style="{StaticResource SectionText}" Margin="0,0,0,4"/>

        <!-- Zone de dépôt : glisser-déposer de fichiers depuis l'Explorateur. -->
        <Border Grid.Row="2" x:Name="DropZone" AllowDrop="True" BorderThickness="2" CornerRadius="8" Padding="8"
                BorderBrush="{StaticResource BrushBorder}" Background="{StaticResource BrushSurface}"
                DragEnter="OnDragEnter" DragLeave="OnDragLeave" Drop="OnDrop" DragOver="OnDragOver">
            <Grid>
                <TextBlock x:Name="DropHint" Text="Déposez vos fichiers ici" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="14"/>
                <ListBox x:Name="FilesList" BorderThickness="0" Background="Transparent" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Click="OnBrowse"/>
            <Button DockPanel.Dock="Left" Content="Retirer" Style="{StaticResource SecondaryButton}" Click="OnRemove" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Annuler" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Enregistrer le contrôle" Style="{StaticResource PrimaryButton}" IsDefault="False" Click="OnOk"/>
        </DockPanel>
    </Grid>
</Window>
