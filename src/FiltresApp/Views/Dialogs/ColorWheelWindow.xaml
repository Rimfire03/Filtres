<Window x:Class="FiltresApp.Views.Dialogs.ColorWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir une couleur"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20" Width="240">
        <!-- Roue chromatique : teinte = angle, saturation = distance au centre (luminosité max) ; la
             luminosité finale est réglée séparément par le curseur ci-dessous, sans avoir à régénérer la
             roue (voir ColorWheelWindow.xaml.cs). -->
        <Border BorderBrush="Gray" BorderThickness="1" Width="220" Height="220" HorizontalAlignment="Left" CornerRadius="110" ClipToBounds="True">
            <Image x:Name="WheelImage" Width="220" Height="220" Stretch="None" Cursor="Cross"
                   MouseLeftButtonDown="WheelImage_MouseLeftButtonDown"
                   MouseMove="WheelImage_MouseMove"
                   MouseLeftButtonUp="WheelImage_MouseLeftButtonUp"/>
        </Border>

        <TextBlock Text="Luminosité" Margin="0,14,0,4" FontWeight="SemiBold"/>
        <Slider x:Name="ValueSlider" Minimum="0" Maximum="1" Value="1" ValueChanged="ValueSlider_ValueChanged"/>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Border Width="40" Height="40" BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0">
                <Border.Background>
                    <SolidColorBrush x:Name="PreviewBrush"/>
                </Border.Background>
            </Border>
            <TextBlock x:Name="HexText" VerticalAlignment="Center" FontFamily="Consolas"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Width="90"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Width="90"/>
        </StackPanel>
    </StackPanel>
</Window>
