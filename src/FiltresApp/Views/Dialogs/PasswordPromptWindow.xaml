<Window x:Class="FiltresApp.Views.Dialogs.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mot de passe" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <PasswordBox x:Name="PasswordInput" Padding="6,5" Margin="0,0,0,8"/>
        <TextBlock x:Name="ErrorText" Foreground="#DC2626" Visibility="Collapsed" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Valider" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk"/>
            <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
