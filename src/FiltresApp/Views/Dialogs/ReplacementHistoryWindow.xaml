<Window x:Class="FiltresApp.Views.Dialogs.ReplacementHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consulter l'historique"
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HeaderText}" Text="Historique des remplacements"/>

        <TextBlock x:Name="HeaderText" Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="YearCombo" Width="120" SelectionChanged="YearCombo_SelectionChanged"/>
        </StackPanel>

        <TextBlock x:Name="NoHistoryText" Grid.Row="3" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed"/>

        <!-- Pas de notion de mois fixe : liste chronologique des remplacements datés de l'année choisie,
             plutôt qu'une grille à 12 mois. Titre et largeur de la colonne "détail" fixés par l'appelant (voir
             ReplacementHistory). Clic droit sur une ligne : menu "Supprimer cet enregistrement" construit dans
             le code-behind (voir ReplacementsGrid_PreviewMouseRightButtonUp) - un MenuItem avec Click défini
             directement en XAML à l'intérieur d'un Setter.Value de Style n'est pas résolu par le compilateur
             XAML. -->
        <DataGrid x:Name="ReplacementsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  ColumnHeaderStyle="{StaticResource WrappingColumnHeaderStyle}"
                  PreviewMouseRightButtonUp="ReplacementsGrid_PreviewMouseRightButtonUp">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="DateColumn" Header="Date du changement" Binding="{Binding DateLabel}" ElementStyle="{StaticResource WrappingCellStyle}"/>
                <DataGridTextColumn x:Name="DetailColumn" Binding="{Binding Detail}" ElementStyle="{StaticResource CenteredCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fermer" Style="{StaticResource SecondaryButton}" Click="Close_Click" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
