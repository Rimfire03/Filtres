<Window x:Class="FiltresApp.Views.Dialogs.ZacAttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pièces jointes" Width="760" Height="460" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Style="{StaticResource HeaderText}" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  SelectionMode="Single" MouseDoubleClick="OnOpen">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Contrôle du" Binding="{Binding DateText}" Width="110"/>
                <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="100"/>
                <DataGridTextColumn Header="Stockage" Binding="{Binding StorageText}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Ouvrir" Style="{StaticResource PrimaryButton}" Click="OnOpen"/>
            <Button DockPanel.Dock="Left" Content="Enregistrer sous..." Style="{StaticResource SecondaryButton}" Click="OnSave"/>
            <Button DockPanel.Dock="Left" Content="Supprimer" Style="{StaticResource DangerButton}" Click="OnDelete" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
