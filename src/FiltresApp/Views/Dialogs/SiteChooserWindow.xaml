<Window x:Class="FiltresApp.Views.Dialogs.SiteChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choix du site" Height="440" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Choisissez un site" Style="{StaticResource HeaderText}"/>
        <ListBox x:Name="SiteList" Grid.Row="1" Margin="0,12,0,12" DisplayMemberPath="Nom" FontSize="14"
                 MouseDoubleClick="OnDoubleClick"/>
        <CheckBox x:Name="DefaultCheck" Grid.Row="2" Margin="0,0,0,12" VerticalContentAlignment="Top"
                  ToolTip="Modifiable dans les paramètres du module MultiSite">
            <TextBlock Text="Toujours ouvrir ce site" Width="300"/>
        </CheckBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Quitter" Style="{StaticResource SecondaryButton}" Width="90" Click="OnCancel"/>
            <Button Content="Ouvrir" Style="{StaticResource PrimaryButton}" Width="110" IsDefault="True" Click="OnOpen"/>
        </StackPanel>
    </Grid>
</Window>
