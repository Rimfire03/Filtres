<Window x:Class="FiltresApp.Views.Dialogs.FilterHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consulter l'historique"
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HeaderText}" Text="Historique des remplacements"/>

        <TextBlock x:Name="HeaderText" Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="YearCombo" Width="120" SelectionChanged="YearCombo_SelectionChanged"/>
        </StackPanel>

        <TextBlock x:Name="NoHistoryText" Grid.Row="3" TextWrapping="Wrap" Foreground="Gray" Visibility="Collapsed"
                   Text="Aucun historique disponible pour ce filtre : aucun remplacement enregistré en base pour l'instant."/>

        <DataGrid x:Name="MonthsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  ColumnHeaderStyle="{StaticResource WrappingColumnHeaderStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mois" Binding="{Binding MonthLabel}" Width="2*" ElementStyle="{StaticResource WrappingCellStyle}"/>
                <DataGridCheckBoxColumn Header="Réalisé" Binding="{Binding IsDone}" Width="*" ElementStyle="{StaticResource CenteredCheckBoxCellStyle}"/>
                <DataGridTextColumn Header="Date du changement" Binding="{Binding DateLabel}" Width="1.6*" ElementStyle="{StaticResource CenteredCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Fermer" Style="{StaticResource SecondaryButton}" Click="Close_Click" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
