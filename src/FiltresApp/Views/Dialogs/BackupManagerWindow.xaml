<Window x:Class="FiltresApp.Views.Dialogs.BackupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des sauvegardes automatiques"
        Height="760" Width="1100" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Gestion des sauvegardes automatiques" Style="{StaticResource HeaderText}"/>
            <TextBlock x:Name="FolderText" Style="{StaticResource SectionText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Planification -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Planification et conservation" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="EnabledCheck" Content="Sauvegarder automatiquement la base" Margin="0,0,0,10" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                <StackPanel Orientation="Horizontal" x:Name="ScheduleRow" Margin="0,0,0,10">
                    <TextBlock Text="Fréquence :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="FrequencyCombo" Width="140" SelectionChanged="OnFrequencyChanged">
                        <ComboBoxItem Tag="Daily" Content="Chaque jour"/>
                        <ComboBoxItem Tag="Weekly" Content="Chaque semaine"/>
                        <ComboBoxItem Tag="Monthly" Content="Chaque mois"/>
                    </ComboBox>
                    <TextBlock x:Name="DayLabel" Text="Jour :" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox x:Name="WeekDayCombo" Width="120" SelectionChanged="OnSettingChanged"/>
                    <ComboBox x:Name="MonthDayCombo" Width="70" SelectionChanged="OnSettingChanged"/>
                    <TextBlock Text="À :" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <TextBox x:Name="TimeBox" Width="60" TextChanged="OnSettingChanged" ToolTip="Heure au format HH:mm (ex. 02:00)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Nombre de sauvegardes à conserver :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="KeepBox" Width="60" TextChanged="OnSettingChanged"/>
                    <TextBlock Text="  (0 = illimité ; s'applique à toutes les sauvegardes .bak du dossier, les plus anciennes sont supprimées)"
                               Style="{StaticResource SectionText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveSettingsButton" Content="Enregistrer les réglages" Style="{StaticResource PrimaryButton}" Click="OnSaveSettings"/>
                    <TextBlock x:Name="ScheduleStatusText" Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Liste des sauvegardes -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Sauvegarder maintenant" Style="{StaticResource PrimaryButton}" Click="OnBackupNow"/>
                <Button Content="Restaurer la sélection..." Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="OnRestore"/>
                <Button Content="Supprimer la sélection" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnDelete"/>
                <Button Content="Ouvrir le dossier" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnOpenFolder"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
            <DataGrid x:Name="BackupGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="150"/>
                    <DataGridTextColumn Header="Ancienneté" Binding="{Binding AgeText}" Width="100"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="1.6*"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120"/>
                    <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="80"/>
                    <DataGridTextColumn Header="Schéma" Binding="{Binding SchemaText}" Width="70"/>
                    <DataGridTextColumn Header="Logiciel" Binding="{Binding AppVersionText}" Width="80"/>
                    <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="ActionStatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="700"/>
            <Button Content="Fermer" Style="{StaticResource SecondaryButton}" Width="100" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
