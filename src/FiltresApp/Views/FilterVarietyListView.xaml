<UserControl x:Class="FiltresApp.Views.FilterVarietyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels"
             xmlns:app="clr-namespace:FiltresApp"
             d:DataContext="{d:DesignInstance vm:FilterVarietyListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource HeaderText}"/>

            <!-- Mode édition : rouge tant que désactivé (par défaut à chaque lancement), vert une fois
                 activé. Toujours visible (contrairement aux boutons ci-dessous) : c'est lui qui les fait
                 apparaître. Placé à l'extrême droite de la page. -->
            <Button Grid.Column="1" Content="{Binding EditModeButtonLabel}" Command="{Binding ToggleEditModeCommand}"
                    VerticalAlignment="Top" Padding="14,8" BorderThickness="0"
                    Foreground="White" FontWeight="SemiBold" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanManageVarieties}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource SectionText}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Visibility="{Binding CanManageVarieties, Converter={StaticResource BoolToVis}}"
                   Text="Créez ici librement de nouvelles variétés de filtres (par exemple « F7 à H13 », « G5 », etc.). Chaque variété devient un sous-menu déroulant sous « Filtres F7 à H14 », avec sa propre grille, ses familles, son historique de remplacements et son rattachement à Commande / Inventaire."/>

        <TextBlock Grid.Row="1" Style="{StaticResource SectionText}" Margin="0,0,0,12" TextWrapping="Wrap"
                   Visibility="{Binding CannotManageVarieties, Converter={StaticResource BoolToVis}}"
                   Text="Aucune variété de filtre n'a encore été créée. Cliquez sur « Mode édition » ci-dessus pour en créer une."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding CanManageVarieties, Converter={StaticResource BoolToVis}}">
            <Button Content="+ Nouvelle variété" Style="{StaticResource PrimaryButton}" Command="{Binding AddVarietyCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
            <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Command="{Binding EditVarietyCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
            <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteVarietyCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
        </StackPanel>

        <ListBox Grid.Row="3" ItemsSource="{Binding Varieties}" SelectedItem="{Binding SelectedVariety}" DisplayMemberPath="Nom"
                 Visibility="{Binding CanManageVarieties, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
