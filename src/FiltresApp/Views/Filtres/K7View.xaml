<UserControl x:Class="FiltresApp.Views.Filtres.K7View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:FiltresApp.Services"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels.Filtres"
             xmlns:app="clr-namespace:FiltresApp"
             d:DataContext="{d:DesignInstance vm:K7ListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedLocations" Source="{Binding Locations}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="FamilyGroupLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource HeaderText}"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="+ Ajouter un lieu" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                <Button Content="Imprimer" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Source={StaticResource GroupedLocations}}" svc:ColumnChooser.Key="Liste K7"
                      SelectedItem="{Binding SelectedLocation}" IsReadOnly="True"
                      AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource WrappingColumnHeaderStyle}" ContextMenuOpening="Grid_ContextMenuOpening">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding RowColorId, Converter={StaticResource RowColorIdToBrush}}"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <!-- Sous-menu construit dynamiquement (K7View.xaml.cs) à partir des
                                         couleurs réglées dans Paramètres, "Couleurs de ligne" (voir RowColorMenu). -->
                                    <MenuItem Header="Couleur" IsEnabled="{x:Static app:App.IsWritable}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lieu" Binding="{Binding Lieu}" Width="3*" ElementStyle="{StaticResource WrappingCellStyle}"/>
                    <DataGridTextColumn Header="N° porte" Binding="{Binding NumeroPorte}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                    <DataGridTextColumn Header="Changement réalisé" Binding="{Binding ChangementRealise, StringFormat='dd/MM/yyyy'}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                    <DataGridTextColumn Header="Nb de filtres" Binding="{Binding NbFiltres}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                </DataGrid.Columns>
                <DataGrid.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}"/>
                </DataGrid.GroupStyle>
            </DataGrid>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Familles K7" Style="{StaticResource HeaderText}" FontSize="16"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="+ Ajouter" Style="{StaticResource PrimaryButton}" Command="{Binding AddFamilyCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Command="{Binding EditFamilyCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
                <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteFamilyCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
            </StackPanel>

            <ListBox Grid.Row="2" ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PeriodicityDisplay, StringFormat='Périodicité : {0}'}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
