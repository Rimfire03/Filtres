<UserControl x:Class="FiltresApp.Views.Filtres.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:FiltresApp.Services"
             xmlns:vm="clr-namespace:FiltresApp.ViewModels.Filtres"
             xmlns:app="clr-namespace:FiltresApp"
             d:DataContext="{d:DesignInstance vm:OrderListViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Lignes regroupées par famille : un bandeau titre par famille (même style que la Liste K7). -->
        <CollectionViewSource x:Key="GroupedLines" Source="{Binding Lines}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="FamilyGroupLabel"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource HeaderText}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Ajouter" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
            <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
            <Button Content="Dupliquer" Style="{StaticResource SecondaryButton}" Command="{Binding DuplicateCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
            <Button Content="Supprimer" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
            <Button Content="Rattacher des filtres..." Style="{StaticResource SecondaryButton}" Command="{Binding LinkFiltersCommand}" IsEnabled="{x:Static app:App.IsWritable}"/>
            <Button Content="Imprimer" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}"/>
            <Button Content="Exporter en PDF" Style="{StaticResource SecondaryButton}" Command="{Binding ExportPdfCommand}" Visibility="{Binding AllowPdfExport, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Famille :" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                <ComboBox ItemsSource="{Binding FamilyFilter.Options}" SelectedItem="{Binding FamilyFilter.Selected}"
                          Width="220" VerticalContentAlignment="Center"/>
                <TextBlock Text="Famille déduite des filtres rattachés à la ligne, ou choisie manuellement dans « Modifier »."
                           Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Source={StaticResource GroupedLines}}" PreviewMouseRightButtonUp="Grid_PreviewMouseRightButtonUp"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True" svc:ColumnChooser.Key="{Binding Title}" SelectedItem="{Binding SelectedLine}" IsReadOnly="True"
                  AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource WrappingColumnHeaderStyle}" ContextMenuOpening="Grid_ContextMenuOpening">
            <DataGrid.Resources>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Background" Value="{Binding RowColorId, Converter={StaticResource RowColorIdToBrush}}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <!-- Sous-menu construit dynamiquement (OrderView.xaml.cs) à partir des couleurs
                                     réglées dans Paramètres, "Couleurs de ligne" (voir RowColorMenu). -->
                                <MenuItem Header="Couleur" IsEnabled="{x:Static app:App.IsWritable}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dimension" Binding="{Binding Designation}" Width="2.5*" ElementStyle="{StaticResource WrappingCellStyle}"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="1.3*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Dimension}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn Header="Référence fournisseur" Binding="{Binding Notes}" Width="1.5*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <!-- Besoin : calculé (grisé, non modifiable) pour les familles G4 plissés, G4 plan et G3 ;
                     saisi directement dans la cellule pour les autres familles. -->
                <DataGridTemplateColumn Header="Besoin" Width="0.8*" SortMemberPath="Need">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Need, Mode=OneWay}"
                                     GotKeyboardFocus="NeedBox_GotKeyboardFocus" LostKeyboardFocus="NeedBox_LostKeyboardFocus"
                                     PreviewKeyDown="NeedBox_PreviewKeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource InlineEditTextBox}">
                                        <Setter Property="IsReadOnly" Value="{x:Static app:App.IsReadOnly}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsesManualNeed}" Value="False">
                                                <Setter Property="IsReadOnly" Value="True"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="ToolTip" Value="Besoin calculé (max de Besoin mars / septembre) : non modifiable pour les familles G4 plissés, G4 plan et G3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Clic droit sur une cellule : menu rapide de rattachement (OrderView.xaml.cs). -->
                <DataGridTextColumn x:Name="LinkedFiltersColumn" Header="Filtres liés" Binding="{Binding LinkedFilterCountDisplay}" Width="1.1*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <DataGridTextColumn x:Name="QuantityColumn" Header="Quantité à commander" Binding="{Binding InventoryQuantity}" Width="*" ElementStyle="{StaticResource CenteredCellStyle}"/>
                <!-- Changement rapide de famille : masquée par défaut (clic droit sur un en-tête pour
                     l'afficher), jamais imprimée ni exportée (colonnes d'impression fixes, voir BuildHeaders). -->
                <DataGridTemplateColumn Header="Famille" Width="1.4*" SortMemberPath="FamilyGroupLabel" svc:ColumnChooser.HiddenByDefault="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Margin="2" VerticalAlignment="Center"
                                      ItemsSource="{Binding DataContext.FamilyQuickChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedItem="{Binding FamilyChoiceLabel, Mode=OneWay}"
                                      IsEnabled="{x:Static app:App.IsWritable}"
                                      SelectionChanged="FamilyCombo_SelectionChanged">
                                <ComboBox.ToolTip>
                                    <TextBlock Text="{Binding AutomaticFamilyLabel, StringFormat='Famille automatique (selon les filtres rattachés) : {0}'}"/>
                                </ComboBox.ToolTip>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}"/>
            </DataGrid.GroupStyle>
        </DataGrid>
    </Grid>
</UserControl>
