<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FiltresApp</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.6.13</Version>
    <Company>TomLine prod&amp;co</Company>
    <Copyright>© TomLine prod&amp;co by Thomas Guidez</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FiltresApp.Core\FiltresApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-logo-white.png" />
    <!-- Uniquement en Debug (confort de développement local) : le fichier .db ne doit jamais être
         inclus dans une release publiée (voir Configuration Release / dotnet publish), ni donc dans le
         .zip distribué. Copiée dans FiltreData\ (et non à la racine) : seul l'exécutable doit rester à
         la racine du dossier publié, voir AppSettings.DataDirectory. -->
    <None Include="data\filtres.db" CopyToOutputDirectory="PreserveNewest" TargetPath="FiltreData\filtres.db" Condition="'$(Configuration)' != 'Release' AND Exists('data\filtres.db')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contrat de licence utilisateur final, intégré à l'exécutable : volontairement PAS copié dans
         FiltreData\, puisque FiltreData\CLUF.txt n'y est écrit qu'à l'acceptation du contrat au premier
         lancement (voir App.Eula.cs). -->
    <EmbeddedResource Include="Legal\CLUF.txt" LogicalName="FiltresApp.CLUF.txt" />
  </ItemGroup>

</Project>
