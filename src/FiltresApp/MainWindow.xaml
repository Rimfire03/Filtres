<Window x:Class="FiltresApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FiltresApp.ViewModels"
        xmlns:views="clr-namespace:FiltresApp.Views"
        xmlns:app="clr-namespace:FiltresApp"
        Title="Suivi maintenance Filtres" Icon="/Assets/app.ico" Height="820" Width="1340"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <DockPanel>
        <!-- Pied de page -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushSidebar}" Padding="16,8"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushSidebarBorder}">
            <Grid>
                <!-- Version de l'application et de la base, tout à droite. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static app:App.CurrentVersion}, StringFormat='Core v{0}'}" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding Source={x:Static app:App.DatabaseVersion}, StringFormat='DB: V{0}'}" FontSize="11" Foreground="#64748B" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Text="© Thomas Guidez  ·  Suivi de maintenance Filtres" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barre latérale moderne -->
            <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BrushSidebarBorder}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                        <!-- Logo de l'entreprise (Paramètres), sur fond blanc pour rester lisible sur la barre sombre -->
                        <Border Background="White" CornerRadius="6" Padding="6" Margin="0,0,0,14" HorizontalAlignment="Left"
                                Visibility="{Binding LogoImage, Converter={StaticResource NullToCollapsed}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="8" Direction="270" ShadowDepth="2"/>
                            </Border.Effect>
                            <Image Source="{Binding LogoImage}" MaxHeight="55" MaxWidth="210" Stretch="Uniform"/>
                        </Border>

                        <!-- En-tête de l'application -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="6" Padding="5" Margin="0,0,10,0">
                                <Image Source="/Assets/app-logo-white.png" Width="22" Height="22" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Filtres" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextOnDark}"/>
                                <TextBlock Text="Suivi de maintenance" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Sélecteur d'année stylé -->
                        <Border Background="#152138" CornerRadius="6" Padding="10,6" Margin="0,16,0,6"
                                BorderBrush="{StaticResource BrushSidebarBorder}" BorderThickness="1">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="Année :" Foreground="#94A3B8" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12.5"/>
                                <ComboBox ItemsSource="{Binding YearContext.AvailableYears}"
                                          SelectedItem="{Binding YearContext.Year}"
                                          Style="{StaticResource SidebarComboBoxStyle}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Séparateur discret -->
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BrushSidebarBorder}" Margin="16,4,16,12"/>

                    <!-- "Aide" : à part du menu défilant ci-dessous, ancré tout en bas de la barre
                         latérale pour rester toujours accessible sans avoir à faire défiler. -->
                    <Border DockPanel.Dock="Bottom" Margin="6,8" CornerRadius="6" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ShowHelpCommand}"/>
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HelpItem.IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushSidebarSelected}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" Margin="14,7">
                            <TextBlock Text="{Binding HelpItem.Icon}" Margin="0,0,10,0" FontSize="14" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                            <TextBlock Text="{Binding HelpItem.Title}" FontSize="13" VerticalAlignment="Center" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>

                    <!-- Menu de navigation -->
                    <TreeView x:Name="NavigationTree" ItemsSource="{Binding NavigationItems}"
                              Background="Transparent" BorderThickness="0" Margin="4,0"
                              SelectedItemChanged="NavigationTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel Margin="0,1">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="6,1" Padding="8,7">
                                                    <DockPanel LastChildFill="True">
                                                        <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Width="22" Height="22"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Visibility="Collapsed" ClickMode="Press" Focusable="False" Margin="0,0,4,0">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                          Data="M 2 1 L 6 5 L 2 9" Stroke="#94A3B8" StrokeThickness="1.5"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Arrow" Property="Data" Value="M 1 2 L 5 6 L 9 2"/>
                                                                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource BrushTextOnDark}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="14,1,0,2"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="True">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSidebarSelected}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,10,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Zone de contenu principal -->
            <DockPanel Grid.Column="1">
                <!-- Bannière d'alerte en lecture seule -->
                <Border DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" Padding="18,10"
                        Visibility="{Binding Source={x:Static app:App.IsReadOnly}, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="15" Foreground="#D97706" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static app:App.ReadOnlyMessage}" TextWrapping="Wrap" Foreground="#92400E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ContentControl Content="{Binding CurrentViewModel}" Background="{StaticResource BrushBackground}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
