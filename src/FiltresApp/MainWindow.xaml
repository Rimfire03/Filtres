<Window x:Class="FiltresApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FiltresApp.ViewModels"
        xmlns:app="clr-namespace:FiltresApp"
        Title="Suivi maintenance Filtres" Icon="/Assets/app.ico" Height="800" Width="1300"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <DockPanel>
        <!-- Pied de page -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushSidebar}" Padding="12,3">
            <TextBlock Text="© Thomas Guidez" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushSidebar}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,20,16,16">
                        <!-- Logo de l'entreprise (Paramètres), sur fond blanc pour rester lisible sur la barre sombre. -->
                        <Border Background="White" CornerRadius="4" Padding="6" Margin="0,0,0,12" HorizontalAlignment="Left"
                                Visibility="{Binding LogoImage, Converter={StaticResource NullToCollapsed}}">
                            <Image Source="{Binding LogoImage}" MaxHeight="60" MaxWidth="200" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/app-logo-white.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Filtres" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextOnDark}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Suivi de maintenance" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        <DockPanel Margin="0,14,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Année :" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding YearContext.AvailableYears}" SelectedItem="{Binding YearContext.Year}"/>
                        </DockPanel>

                        <!-- Mode édition : rouge quand désactivé (par défaut à chaque lancement), vert
                             une fois activé. Autorise la création de nouvelles variétés "Filtres F7 à H14". -->
                        <Button Content="{Binding EditModeButtonLabel}" Command="{Binding ToggleEditModeCommand}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,8" BorderThickness="0"
                                Foreground="White" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditModeEnabled}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TreeView x:Name="NavigationTree" ItemsSource="{Binding NavigationItems}"
                              Background="Transparent" BorderThickness="0"
                              SelectedItemChanged="NavigationTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="Bd" Background="Transparent" Padding="0">
                                                    <DockPanel LastChildFill="True">
                                                        <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Width="24" Height="36"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Visibility="Collapsed" ClickMode="Press" Focusable="False">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <TextBlock x:Name="Arrow" Text="&#9656;" Foreground="#9CA3AF" FontSize="11"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Arrow" Property="Text" Value="&#9662;"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="0,10"/>
                                                    </DockPanel>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="True">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSidebarSelected}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSidebarHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,10,0" FontSize="14"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="16,10"
                        Visibility="{Binding Source={x:Static app:App.IsReadOnly}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{x:Static app:App.ReadOnlyMessage}" TextWrapping="Wrap" Foreground="#92400E" FontWeight="SemiBold"/>
                </Border>
                <ContentControl Content="{Binding CurrentViewModel}" Background="{StaticResource BrushBackground}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
